{
	"name": "@marc-r2/crdt-contracts",
	"version": "0.1.0",
	"private": true,
	"description": "Implementation-free wire contracts (types + constants) shared by the Obsidian plugin and the sync server.",
	"license": "0-BSD",
	"type": "commonjs",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist",
		"src",
		"compat-manifest.json"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"build:openapi": "node scripts/build-openapi.mjs",
		"check:openapi": "node scripts/check-openapi.mjs",
		"compat:gate": "node scripts/compat-gate.mjs",
		"precompat:gate": "npm run build",
		"test": "vitest run",
		"pretest": "npm run build",
		"test:watch": "vitest watch"
	},
	"devDependencies": {
		"@hanazuki/node-jsonnet": "3.0.1",
		"@types/node": "^26.1.2",
		"typescript": "^5.8.3",
		"vite": "^8.2.0",
		"vitest": "^5.0.0"
	}
}
